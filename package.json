{
  "name": "diffium-db",
  "version": "0.1.0",
  "description": "Live TUI that shows what is changing in your database — structure and rows — while an agent works.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "diffium-db": "./src/index.ts"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "start": "bun run src/index.ts",
    "watch": "bun run src/index.ts watch",
    "test": "bun test",
    "check": "bunx tsc --noEmit",
    "fmt": "bunx prettier --write src"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "dependencies": {
    "@opentui/core": "0.5.9"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2"
  }
}
